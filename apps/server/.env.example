DATABASE_URL="postgresql://auction:auction@localhost:5433/football_auction"
PORT=4000
# Comma-separated list, or * to allow any origin (handy for LAN play in development)
CLIENT_ORIGIN="http://localhost:3000"
# Where seed data lives (relative to apps/server)
DATA_DIR="../../data"
# "db" (PostgreSQL, default) or "file" (read data/seed directly, no persistence)
STORAGE="db"
# Development-only overrides (leave unset for real games)
# DEV_SOLD_REVEAL_MS=3500
# DEV_START_COUNTDOWN_MS=3000
# Optional AI pundit on the results screen (explains results, never decides them).
# ANTHROPIC_API_KEY=
# AI_COMMENTARY=off
